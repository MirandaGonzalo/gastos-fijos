# Copiá este archivo como .env y completá los valores.

# Conexión al Postgres del docker-compose (puerto 5433)
DATABASE_URL="postgresql://gastos:gastos@localhost:5433/gastos_fijos?schema=public"

# Puerto de la API
PORT=3100

# Origen del front permitido por CORS (en desarrollo)
FRONTEND_URL="http://localhost:5180"

# API pública de cotizaciones del dólar
DOLAR_API_URL="https://dolarapi.com/v1/dolares"
